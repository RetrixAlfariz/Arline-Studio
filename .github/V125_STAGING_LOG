d here without changing canon automatically.</div></div></div>\n            </aside>\n          </div>\n        </section>\n\n        <!-- WORLD -->\n        <section id="worldView" class="workspace-view" data-view-panel="world">\n          <div class="world-layout">\n            <header class="world-header">\n              <div><span class="eyebrow">Library</span><h1 id="worldTitle">Main</h1><p id="worldDescription">Canonical entities, variants, relationships, timeline, and lore.</p></div>\n              <div class="world-actions">\n                <button id="continuityBtn" class="secondary-btn">Continuity</button>\n                <button id="compareBranchBtn" class="secondary-btn">Compare branches</button>\n                <button id="compareWorldBtn" class="secondary-btn">Compare worlds</button>\n                <button id="snapshotBtn" class="secondary-btn">Snapshot</button>\n                <button id="sandboxBtn" class="secondary-btn">What-if</button>\n                <button id="newEntityBtn" class="primary-btn">＋ New</button>\n              </div>\n            </header>\n            <nav class="world-tabs" id="worldTabs">\n              <button class="active" data-world-tab="character">Characters</button>\n              <button data-world-tab="location">Locations</button>\n              <button data-world-tab="item">Items</button>\n              <button data-world-tab="organization">Organizations</button>\n              <button data-world-tab="relationship">Relationships</button>\n              <button data-world-tab="lore">Lore</button>\n              <button data-world-tab="canon">Canon facts</button>\n              <button data-world-tab="timeline">Timeline</button>\n              <button data-world-tab="worlds">Worlds & branches</button>\n            </nav>\n            <div class="world-content world-library-shell">\n              <aside class="world-library-rail">\n                <div class="section-title-row"><span class="section-label">Library</sp