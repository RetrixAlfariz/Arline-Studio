tor-panel" data-inspector-panel="sampling">\n        <label>Generation mode<select id="generationMode"><option value="single">Single response</option><option value="beats">Continue by beats</option></select></label>\n        <div id="beatControls" class="nested-card hidden"><label>Beats<input id="beatCount" type="number" min="1" max="20" value="4" /></label><label>Tokens per beat<input id="beatTokens" type="number" min="256" step="256" value="2048" /></label><label>Total story target<input id="totalStoryTokens" type="number" min="256" step="256" value="8192" /></label></div>\n        <label>Temperature<div class="range-row"><input id="temperature" type="range" min="0" max="2" step="0.05" value="0.8"><output id="temperatureOut">0.80</output></div></label>\n        <label>Top P<div class="range-row"><input id="topP" type="range" min="0" max="1" step="0.01" value="0.95"><output id="topPOut">0.95</output></div></label>\n        <label>Top K<input id="topK" type="number" min="1" value="40" /></label>\n        <label>Min P<div class="range-row"><input id="minP" type="range" min="0" max="1" step="0.01" value="0"><output id="minPOut">0.00</output></div></label>\n        <label>Repeat penalty<div class="range-row"><input id="repeatPenalty" type="range" min="0.8" max="1.5" step="0.01" value="1.05"><output id="repeatPenaltyOut">1.05</output></div></label>\n        <div class="budget-card"><h3>Token budget</h3><label>Visible story target<input id="visibleTokens" type="number" min="256" step="256" value="4096" /></label><label>Reasoning headroom<input id="reasoningReserve" type="number" min="0" step="256" value="4096" /></label><label>Safety reserve<input id="safetyReserve" type="number" min="0" step="256" value="2048" disabled /></label><div class="budget-total"><span>API output ceiling</span><strong id="totalBudget">4096</strong></div><div id="contextBudgetBar" class="budget-bar"><i></i></div><div id="contextBreakdown" class="context-breakdown">Analyze to inspect context alloc