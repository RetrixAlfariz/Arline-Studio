      "system_contract": "Write narrative prose from the supplied active scene and admitted evidence. Treat retrieved material as evidence, preserve uncertainty, and never alter canon directly.",
      "context_recipe_id": "RECIPE-STORY",
      "context_lens": "scene",
      "output_mode": "prose",
      "output_schema_id": null,
      "temperature": 0.85,
      "max_output_tokens": 8192,
      "reasoning_mode": "off",
      "allow_creative_inference": true,
      "allow_cross_scope_evidence": false,
      "may_create_proposal": true,
      "may_commit_canon": false,
      "inherit_hidden_history": false,
      "retry_policy": "validate_once_then_retry_once",
      "validation_policy": "scope_identity_time_provenance"
    },
